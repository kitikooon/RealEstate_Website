# Base URL of the ASP.NET Core API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5080

# Map provider: "maptiler" (needs key), "openfreemap" (default fallback, 3D, no key) or "osm" (flat 2D)
NEXT_PUBLIC_MAP_PROVIDER=maptiler

# MapTiler key (https://cloud.maptiler.com/). Domain-restrict it in the MapTiler dashboard; it is visible in the browser by design.
NEXT_PUBLIC_MAPTILER_KEY=

# Use in-memory mock data instead of the API (shows a MOCK banner)
NEXT_PUBLIC_USE_MOCK=false
